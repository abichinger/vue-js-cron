  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.6",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue-js-cron/generated": "file:../generated",
    "@vue/tsconfig": "^0.9.1",
    "naive-ui": "^2.44.1",
    "npm-run-all2": "^9.0.3",
